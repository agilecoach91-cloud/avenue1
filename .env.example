# --- App ---
# Public URL of the deployed app (no trailing slash). Used in SMS, emails, ICS and embed links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Product name shown in the UI and messages.
NEXT_PUBLIC_APP_NAME=Bookd
# Optional: a sample business slug for the "Try a sample booking" button on the home page.
NEXT_PUBLIC_DEMO_SLUG=

# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service_role key. Server only, never expose.
SUPABASE_SECRET_KEY=

# --- SMS: Twilio (optional in development; messages are logged instead) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either an alphanumeric sender ID (e.g. "Bookd", max 11 chars, one-way only in AU)
# or an Australian mobile number in E.164 (+614...).
TWILIO_FROM=

# --- Email: Resend (optional in development; messages are logged instead) ---
RESEND_API_KEY=
EMAIL_FROM="Bookd <bookings@yourdomain.com>"

# --- Google Places (optional: prefill a business from its Google listing at signup) ---
GOOGLE_PLACES_API_KEY=

# --- Cron ---
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
